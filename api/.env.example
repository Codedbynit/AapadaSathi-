# Example Environment File (DO NOT PUT REAL SECRETS HERE)
OPENWEATHER_API_KEY=your_openweather_api_key_here
GEONAMES_USERNAME=your_geonames_username_here

# CARTO Basemap API Key — get a free key at https://carto.com/
# Set this in Vercel Environment Variables dashboard as: CARTO_BASEMAP_API_KEY
CARTO_BASEMAP_API_KEY=

# NASA FIRMS key (free registration at https://firms.modaps.eosdis.nasa.gov/)
# Set this in Vercel Environment Variables dashboard as: NASA_FIRMS_MAP_KEY
NASA_FIRMS_MAP_KEY=

# Frontend Production API Config (Vercel)
# Set this in your Vercel Environment Variables dashboard
VITE_API_BASE_URL=https://your-production-fastapi-backend.com/api
